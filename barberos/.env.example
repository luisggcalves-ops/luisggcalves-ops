# App database connection. Uses the restricted `barberos_web` role, which is subject to row-level security.
DATABASE_URL=postgres://barberos_web:barberos_web@localhost:5432/barberos
# Migration connection. Uses the database owner role, which runs DDL.
MIGRATION_DATABASE_URL=postgres://barberos_owner:barberos_owner@localhost:5432/barberos

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Email (optional in development: without a key, emails are printed to the server console)
RESEND_API_KEY=
MAIL_FROM="BarberOS <no-reply@example.com>"

# Protects the email retry endpoint (/api/cron/outbox). Any long random string.
CRON_SECRET=
